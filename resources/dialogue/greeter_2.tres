[ext_resource type="Script" path="res://scripts/dialogue_data.gd" id="1_dial"]

[resource]
script = ExtResource("1_dial")
speaker_name = "Mira"
text = "Your great grandfather's shop? Oh my, Eldric's grandchild! We've been wondering when someone would come. The old Emporium is just down the lane — the big building with the bay window."
next_id = "greet_3"
